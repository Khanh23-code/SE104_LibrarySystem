<UserControl x:Class="THUVIENZ.Views.Favorite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:THUVIENZ"
        xmlns:comp="clr-namespace:THUVIENZ.Views.Components">

    <UserControl.Resources>
        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="White" CornerRadius="35"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Width="900" Height="620">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Opacity="0.2" ShadowDepth="10" Color="Black"/>
            </Border.Effect>

            <Grid Margin="60,50,60,50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock Text="Sách yêu thích" FontSize="36" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Những cuốn sách bạn đã lưu lại để đọc sau" FontSize="16" Foreground="#6B7280" Margin="0,5,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                    <ItemsControl ItemsSource="{Binding FavoriteBooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <comp:BookCard BookTitle="{Binding TenSach}" 
                                               Author="{Binding TacGia}" 
                                               BookId="{Binding MaSach}" 
                                               Price="{Binding TriGia}" 
                                               CoverImage="{Binding HinhAnh, TargetNullValue='/Assets/phai.png', FallbackValue='/Assets/phai.png'}"
                                               CommandParameter="{Binding}"
                                               LikeCommand="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               BorrowCommand="{Binding DataContext.BorrowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               BorrowEnabled="{Binding IsBorrowEnabled}"
                                               BorrowButtonText="{Binding BorrowButtonText}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>