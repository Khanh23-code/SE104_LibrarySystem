<UserControl x:Class="THUVIENZ.Views.Borrowing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:THUVIENZ"
        xmlns:converters="clr-namespace:THUVIENZ.Converters">

    <UserControl.Resources>
        <!-- Status badge converters -->
        <converters:StatusToBadgeBackgroundConverter  x:Key="StatusToBg"/>
        <converters:StatusToBadgeForegroundConverter  x:Key="StatusToFg"/>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background"           Value="Transparent"/>
            <Setter Property="BorderThickness"      Value="0"/>
            <Setter Property="RowBackground"        Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="HeadersVisibility"    Value="Column"/>
            <Setter Property="GridLinesVisibility"  Value="None"/>
            <Setter Property="AutoGenerateColumns"  Value="False"/>
            <Setter Property="IsReadOnly"           Value="True"/>
            <Setter Property="SelectionMode"        Value="Extended"/>
            <Setter Property="SelectionUnit"        Value="FullRow"/>
            <Setter Property="FontSize"             Value="15"/>
            <Setter Property="CanUserResizeRows"    Value="False"/>
            <!-- Add neat UI spacing -->
            <Setter Property="RowHeight"            Value="60"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"     Value="#F3F4F6"/>
            <Setter Property="Foreground"     Value="#6B7280"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Padding"        Value="15,16"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"    Value="#E5E7EB"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#F3F4F6"/>
            <!-- Remove highlight when row is clicked/selected -->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#F3F4F6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Remove highlight when cell is selected -->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action button base style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Padding"        Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="White" CornerRadius="35"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Opacity="0.12" ShadowDepth="8" Color="Black"/>
            </Border.Effect>

            <Grid Margin="50,40,50,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="*"/>     <!-- Table -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📚 Sách Đang Mượn" FontSize="32" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Danh sách toàn bộ sách bạn đã và đang mượn từ thư viện"
                                   FontSize="15" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Live overdue badge -->
                    <Border Grid.Column="1" VerticalAlignment="Center"
                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5"
                            CornerRadius="12" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock FontSize="13" Foreground="#6B7280">
                                    <Run Text="Sách quá hạn: "/>
                                    <Run FontWeight="Bold" Foreground="#DC2626"
                                         Text="{Binding OverdueCount, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="13" Foreground="#6B7280">
                                    <Run Text="Tổng tiền phạt: "/>
                                    <Run FontWeight="Bold" Foreground="#DC2626"
                                         Text="{Binding TotalFineDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── DataGrid ── -->
                <Border Grid.Row="1" Background="White" CornerRadius="16"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  Style="{StaticResource ModernDataGrid}"
                                  Margin="6"
                                  ItemsSource="{Binding MyBorrowedBooks}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>

                                    <!-- Mã Phiếu -->
                                    <DataGridTextColumn Header="Mã Phiếu"
                                                        Binding="{Binding TicketID}"
                                                        Width="150" MinWidth="130"/>

                                    <!-- Tên Sách -->
                                    <DataGridTextColumn Header="Tên Sách"
                                                        Binding="{Binding BookTitle}"
                                                        Width="*" MinWidth="250">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#111827"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Ngày Mượn -->
                                    <DataGridTextColumn Header="Ngày Mượn"
                                                        Binding="{Binding BorrowDate}"
                                                        Width="150" MinWidth="130"/>

                                    <!-- Hạn Trả -->
                                    <DataGridTextColumn Header="Hạn Trả"
                                                        Binding="{Binding DueDate}"
                                                        Width="150" MinWidth="130"/>

                                    <!-- Trạng Thái — colored badge -->
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="150" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                                        CornerRadius="20" Padding="12,6"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToFg}}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Hành Động -->
                                    <DataGridTemplateColumn Header="Hành Động" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Đã trả">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                            </DataGrid.Columns>
                                </DataGrid>

                        <!-- Actions bar -->
                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="⏱ Gia hạn đã chọn"
                                        Margin="0,0,12,0"
                                        Command="{Binding GiaHanCommand}"
                                        Style="{StaticResource ActionBtn}"
                                        Background="#EFF6FF" Foreground="#2563EB"/>

                                <Button Content="↩ Trả sách đã chọn"
                                        Command="{Binding TraSachCommand}"
                                        Style="{StaticResource ActionBtn}"
                                        Background="#FEF2F2" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>